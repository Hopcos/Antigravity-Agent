# ==============================================================
# GeminiAgent Gateway Configuration
# ==============================================================

# 可选：对外暴露的 API Key（若为空则无需认证）
GATEWAY_API_KEY=sk-antigravity

# 默认转发的模型
GEMINI_DEFAULT_MODEL=gemini-3.8-flash-high

# 凭据来源模式：Auto (优先 Windows Credential Manager -> oauth_creds.json -> ADC)
ANTIGRAVITY_AUTH_SOURCE=Auto

# Windows 凭据管理器目标名（默认 gemini:antigravity）
ANTIGRAVITY_CREDENTIAL_TARGET=gemini:antigravity

# 手动指定 Refresh Token（如果部署在 Linux 服务器或 Docker 容器内）
# ANTIGRAVITY_REFRESH_TOKEN=1//04xxxxxxxxxxxx
# ANTIGRAVITY_CLIENT_ID=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com
# ANTIGRAVITY_CLIENT_SECRET=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

# Antigravity 专属上游项目与接口
ANTIGRAVITY_PROJECT=aicode-consumers
ANTIGRAVITY_BASE_URL=https://daily-cloudcode-pa.googleapis.com/v1internal
ANTIGRAVITY_USER_AGENT=antigravity/2.24.0 (win32; x64)

# 最大并发连接数
ANTIGRAVITY_MAX_CONCURRENCY=2
